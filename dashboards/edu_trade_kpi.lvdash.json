{
  "datasets": [
    {
      "name": "a1dc3533",
      "displayName": "채널별 체결",
      "queryLines": [
        "SELECT COALESCE(channel, '미상') AS channel, COUNT(*) AS exec_cnt, SUM(exec_amt) AS exec_amt FROM (SELECT DISTINCT * FROM kpsec.sandbox_edu.eis_tr_order_<my_id> WHERE qty > 0 AND order_stat = '체결') GROUP BY 1"
      ]
    },
    {
      "name": "9f31b7e9",
      "displayName": "일별 거래 KPI",
      "queryLines": [
        "SELECT base_date, trade_acct_cnt, exec_cnt, exec_amt FROM kpsec.sandbox_edu.daily_trade_kpi_<my_id> ORDER BY base_date"
      ]
    },
    {
      "name": "f0e93404",
      "displayName": "주문 데이터 품질",
      "queryLines": [
        "SELECT COUNT(*) AS total, COUNT(*) - COUNT(DISTINCT order_id) AS dup_rows, SUM(CASE WHEN qty <= 0 THEN 1 END) AS bad_qty, SUM(CASE WHEN channel IS NULL THEN 1 END) AS null_channel FROM kpsec.sandbox_edu.eis_tr_order_<my_id>"
      ]
    },
    {
      "name": "0ff4b1c6",
      "displayName": "계좌유형별 체결금액",
      "queryLines": [
        "SELECT a.acct_type_nm, SUBSTR(o.base_date, 1, 6) AS ym, SUM(o.exec_amt) AS amt FROM (SELECT DISTINCT * FROM kpsec.sandbox_edu.eis_tr_order_<my_id> WHERE qty > 0 AND order_stat = '체결') o JOIN kpsec.sandbox_edu.eis_ac_account_<my_id> a USING (acct_no) WHERE a.acct_stat = '정상' GROUP BY 1, 2 ORDER BY 2, 1"
      ]
    },
    {
      "name": "043be6c0",
      "displayName": "종목별 최근 종가",
      "queryLines": [
        "SELECT s.stock_nm, p.base_date, p.close_px FROM kpsec.sandbox_edu.stock_price_daily_<my_id> p JOIN kpsec.sandbox_edu.dim_stock_<my_id> s USING (stock_cd) WHERE p.base_date = (SELECT MAX(base_date) FROM kpsec.sandbox_edu.stock_price_daily_<my_id>) ORDER BY p.close_px DESC LIMIT 10"
      ]
    },
    {
      "name": "ac7a0045",
      "displayName": "월별 신규 계좌",
      "queryLines": [
        "SELECT SUBSTR(open_dt, 1, 6) AS ym, COUNT(*) AS new_accts FROM kpsec.sandbox_edu.eis_ac_account_<my_id> GROUP BY 1 ORDER BY 1"
      ]
    }
  ],
